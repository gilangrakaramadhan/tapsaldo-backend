# Ambil dari dashboard.midtrans.com (mode Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# Ambil dari Firebase Console > Project Settings > Service Accounts > Generate new private key
# Tempel seluruh isi file JSON-nya di sini dalam satu baris
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
FIREBASE_DB_URL=https://nama-project-default-rtdb.asia-southeast1.firebasedatabase.app

PORT=3000
